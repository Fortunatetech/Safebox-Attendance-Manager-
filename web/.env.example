# Google Sheets (service account) — all three required to use the real sheet.
# Omit them entirely to run against in-memory mock data.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# NextAuth
AUTH_SECRET=
ADMIN_USERNAME=
# Generate with: node scripts/hash-password.mjs "your-password"
# Next.js expands "$" in .env files as variable references — escape every "$" in the
# hash as "\$" or the value will be silently corrupted (this bit us during local dev).
ADMIN_PASSWORD_HASH=

# Office geofence — optional. Leave both blank to disable (kiosk works from anywhere,
# which is also the local-dev default). Set both to require staff to be physically at
# the office (checked via the browser's Geolocation API) to sign in/out.
OFFICE_LAT=
OFFICE_LNG=
# Allowed distance from OFFICE_LAT/OFFICE_LNG, in meters. Defaults to 150 if unset —
# GPS drifts more indoors, so avoid setting this too tight.
OFFICE_RADIUS_METERS=
